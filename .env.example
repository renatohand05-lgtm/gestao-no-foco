# Env de referência — Gestão no Foco

# URL canônica do app (convites, metadata, redirects). Em produção NÃO use localhost.
APP_URL=https://gestao-no-foco.vercel.app
NEXT_PUBLIC_APP_URL=https://gestao-no-foco.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observabilidade / hardening (opcional)
LOG_LEVEL=info
SLOW_QUERY_MS=800
MAINTENANCE_MODE=0
DEBUG_STACK=0

# Financeiro — exibir itens Legacy no menu (0/false = só Enterprise)
NEXT_PUBLIC_FINANCE_SHOW_LEGACY=0

# —— Analytics / BI (Fase 23) ——
ANALYTICS_ENABLED=1
ANALYTICS_EXTERNAL_AI_ENABLED=0
ANALYTICS_EXPORT_EXCEL_ENABLED=0
ANALYTICS_EXPORT_PDF_ENABLED=0

# —— CRM Enterprise (Fase 24) ——
CRM_ENTERPRISE_ENABLED=1
CRM_EXTERNAL_AI_ENABLED=0
CRM_EXTERNAL_INTEGRATIONS_ENABLED=0

# —— Supply Chain / Compras / Estoque Enterprise (Fase 25) ——
SUPPLY_ENTERPRISE_ENABLED=1
SUPPLY_EXTERNAL_AI_ENABLED=0
SUPPLY_EXTERNAL_INTEGRATIONS_ENABLED=0

# —— Tax Intelligence (Sprint 26.7) — default: módulo on; integrações/IA externa off ——
TAX_INTELLIGENCE_ENABLED=1
TAX_EXTERNAL_INTEGRATIONS_ENABLED=0
TAX_EXTERNAL_AI_ENABLED=0

# —— Import Intelligence (Sprint 22.8–22.10.1 / 25.4.1) — default SEGURO ——
# Nunca prefixar secrets com NEXT_PUBLIC_. Flags abaixo são server-side.
IMPORT_EXTERNAL_AI_ENABLED=0
IMPORT_OCR_ENABLED=0
# Provider: none | mock_test (somente não-produção) | external
IMPORT_OCR_PROVIDER=none
# IMPORT_OCR_API_KEY=
IMPORT_CNAB_ENABLED=0
IMPORT_CONNECTORS_ENABLED=0
WEBHOOK_IMPORT_ENABLED=0
IMPORT_API_ENABLED=0
IMPORT_AUTO_SYNC_ENABLED=0
IMPORT_ASYNC_PROCESSING_ENABLED=0
# Capacidades CORE da Central de Importação (default ON — desligar só se necessário)
IMPORT_CATALOG_ENABLED=1
IMPORT_STOCK_EXCEL_ENABLED=1
IMPORT_STOCK_CSV_ENABLED=1
IMPORT_NFE_XML_ENABLED=1
IMPORT_PDF_SEARCHABLE_ENABLED=1
# Limites de upload (MB) — fonte única; UI/API/parser usam estes valores
IMPORT_MAX_FILE_SIZE_MB=25
IMPORT_MAX_XML_MB=10
IMPORT_MAX_CSV_MB=20
IMPORT_MAX_EXCEL_MB=25
IMPORT_MAX_PDF_MB=20
# Apenas emergência/dev: permite stores em memória na Import Engine em NODE_ENV=production
ALLOW_IMPORT_MEMORY=0

# Nunca prefixar SERVICE_ROLE ou secrets com NEXT_PUBLIC_

# —— Billing SaaS (Sprint 33.3/33.4) — provider-agnostic + Asaas sandbox ——
# BILLING_ENFORCEMENT=1 liga restrição por assinatura (default off = não bloqueia piloto/teste)
BILLING_ENFORCEMENT=0
# Provedor: none | stripe | asaas | mercadopago | other
BILLING_PROVIDER=none
BILLING_PILOT_TRIAL_DAYS=30
# Valor sandbox quando plano pilot tem amount_cents null
BILLING_SANDBOX_AMOUNT=19.9
# Opt-in explícito para criar customer/subscription no Asaas (sandbox)
BILLING_ASAAS_CHECKOUT_ENABLED=0
# Asaas: SEMPRE sandbox até autorização de go-live
ASAAS_ENV=sandbox
# ASAAS_ALLOW_PRODUCTION=0
# Secrets SOMENTE servidor (NÃO usar NEXT_PUBLIC_):
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
# BILLING_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# —— Supabase Auth (manual no Dashboard) ——
# Site URL: https://gestao-no-foco.vercel.app
# Redirect URLs (mínimo):
#   https://gestao-no-foco.vercel.app/**
#   https://gestao-no-foco.vercel.app/api/auth/callback
#   https://gestao-no-foco.vercel.app/convite/**
# emailRedirectTo no client deve apontar para /api/auth/callback no domínio oficial.
