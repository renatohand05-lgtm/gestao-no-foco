# Paths relative to apps/mobile/ (directory of this file + eas.json).
# Ref: https://docs.expo.dev/build-reference/easignore/
# Sprint 31.11.12 — fix: previous paths assumed monorepo root and were ignored.

# Monorepo root dependencies / caches (EAS reinstalls)
../../node_modules/
../../**/node_modules/

# Next.js local builds (~300MB+)
../../.next/
../../.next-build/
../../.next-build-*/
../../.vercel/
../../out/

# Docs / evidence (~207MB)
../../docs/

# Web-only Next app surface (not Metro mobile)
../../app/
../../components/
../../public/uploads/
../../data/

# Homologation scripts (not Metro)
../../scripts/
../../coverage/
../../playwright-report/
../../test-results/

# Local mobile artifacts
.expo/
dist/
dist-android/
dist-ios/
dist-ios-export-check/
web-build/
ios/
android/
test/
**/.turbo/

# Logs / dumps (repo root + local)
../../**/*.log
../../*-release-*.log
../../build-release-*.log
../../lint-release-*.log
../../vercel-deploy-*.json
../../vercel-inspect-*.json
**/*.log
*.tsbuildinfo
../../*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
../../.env
../../.env.*
!../../.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Store artifacts
*.apk
*.aab
*.ipa
*.app.dSYM.zip

# IDE / VCS
../../.git/
../../.idea/
../../.vscode/
../../.cursor/
.DS_Store
../../.yarn/
!../../.yarn/patches
!../../.yarn/plugins
!../../.yarn/releases
!../../.yarn/versions
../../.pnp
../../.pnp.*

# Supabase temp
../../supabase/.branches/
../../supabase/.temp/
