# Public env vars only — no secrets
# API do app (Next.js / Vercel) — NÃO use a URL do Supabase aqui
EXPO_PUBLIC_API_BASE_URL=https://gestao-no-foco.vercel.app
EXPO_PUBLIC_APP_ENV=development

# Auth / dados (projeto Supabase)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional: sobrescreve o projectId padrão em app.config.ts (já vinculado a @gesto-no-foco/gestao-no-foco)
# EAS_PROJECT_ID=
