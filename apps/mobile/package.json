{
  "name": "@gof/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "node --experimental-strip-types --test test/**/*.test.mjs",
    "doctor": "npx expo-doctor",
    "prebuild-check": "npx expo config --type public",
    "build": "npx expo export --platform android --output-dir dist-android --dump-sourcemap false"
  },
  "dependencies": {
    "@gof/api-contracts": "*",
    "@gof/config": "*",
    "@gof/design-tokens": "*",
    "@gof/domain": "*",
    "@gof/rbac-contracts": "*",
    "@gof/schemas": "*",
    "@gof/utils": "*",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.10",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "react": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
